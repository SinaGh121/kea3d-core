{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kea3d-app",
  "compatibility_date": "2026-08-27",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "app.kea3d.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
