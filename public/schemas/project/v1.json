{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kea3d.com/schemas/project/v1.json",
  "title": "Kea3D Project v1",
  "description": "A local, reference-based Kea3D assembly project.",
  "type": "object",
  "required": ["$schema", "format", "version", "name", "rootInstance", "resources", "instances"],
  "properties": {
    "$schema": { "const": "https://kea3d.com/schemas/project/v1.json" },
    "format": { "const": "kea3d-project" },
    "version": { "const": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 256 },
    "rootInstance": { "$ref": "#/$defs/id" },
    "resources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": { "$ref": "#/$defs/resource" }
    },
    "instances": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/instance" }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$"
    },
    "resourceUri": {
      "type": "string",
      "minLength": 5,
      "maxLength": 1024,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*[\\\\?#])[A-Za-z0-9 _.,+@()'&-]+(?:/[A-Za-z0-9 _.,+@()'&-]+)*\\.[Gg][Ll][Bb]$"
    },
    "resource": {
      "type": "object",
      "required": ["id", "uri"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "uri": { "$ref": "#/$defs/resourceUri" },
        "integrity": { "$ref": "#/$defs/resourceIntegrity" }
      },
      "additionalProperties": true
    },
    "resourceIntegrity": {
      "type": "object",
      "properties": {
        "byteLength": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
      },
      "anyOf": [
        { "required": ["byteLength"] },
        { "required": ["sha256"] }
      ],
      "additionalProperties": true
    },
    "attachment": {
      "type": "object",
      "required": ["sourceAnchor", "targetInstance", "targetAnchor"],
      "properties": {
        "sourceAnchor": { "$ref": "#/$defs/id" },
        "targetInstance": { "$ref": "#/$defs/id" },
        "targetAnchor": { "$ref": "#/$defs/id" }
      },
      "additionalProperties": true
    },
    "instance": {
      "type": "object",
      "required": ["id", "resource"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "resource": { "$ref": "#/$defs/id" },
        "attachment": { "$ref": "#/$defs/attachment" }
      },
      "additionalProperties": true
    }
  }
}
