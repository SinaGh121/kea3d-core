{
  "name": "kea3d",
  "private": true,
  "version": "0.1.72",
  "type": "module",
  "scripts": {
    "sync:decoders": "node scripts/sync-three-decoders.mjs",
    "sync:android-icons": "node scripts/sync-android-icons.mjs",
    "sync:legal": "node scripts/sync-legal-assets.mjs",
    "predev": "npm run sync:legal && npm run sync:decoders && npm run sync:android-icons",
    "dev": "vite",
    "prebuild": "npm run sync:legal && npm run sync:decoders && npm run sync:android-icons",
    "build": "tsc -b && vite build",
    "prepreview": "npm run sync:legal && npm run sync:decoders",
    "preview": "vite preview",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "mobile:android:init": "tauri android init",
    "mobile:android:dev": "tauri android dev",
    "mobile:android:build": "tauri android build",
    "mobile:android:package": "powershell -ExecutionPolicy Bypass -File ./scripts/build-android.ps1",
    "mobile:ios:init": "tauri ios init",
    "mobile:ios:dev": "tauri ios dev",
    "version:check": "node scripts/product-version.mjs check",
    "version:set": "node scripts/product-version.mjs set",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --exclude tests/browser/**",
    "test:browser": "playwright test",
    "check": "npm run version:check && npm run lint && npm run typecheck && npm run test",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "check:release": "npm run check && npm run build && npm run check:bundle && npm run test:browser"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "assimpjs": "^0.0.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "lucide-react": "1.34.0",
    "next-themes": "^0.4.6",
    "occt-import-js": "^0.0.23",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.19.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "three": "0.185.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "26.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "6.1.0",
    "eslint": "10.9.1",
    "globals": "17.11.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "4.1.11",
    "workbox-window": "^7.4.1"
  }
