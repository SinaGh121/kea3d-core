<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.kea3d"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>

            <!-- Android model MIME associations. Kept outside the generated block. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="model/gltf-binary" />
                <data android:mimeType="model/gltf+binary" />
                <data android:mimeType="model/gltf+json" />
                <data android:mimeType="application/gltf-binary" />
                <data android:mimeType="application/gltf-buffer" />
                <data android:mimeType="application/glb" />
                <data android:mimeType="application/x-glb" />
                <data android:mimeType="application/x-blorb" />
                <data android:mimeType="application/x-glulx" />
                <data android:mimeType="model/stl" />
                <data android:mimeType="application/sla" />
                <data android:mimeType="application/vnd.ms-pki.stl" />
                <data android:mimeType="model/3mf" />
                <data android:mimeType="application/vnd.ms-package.3dmanufacturing-3dmodel+xml" />
                <data android:mimeType="model/obj" />
                <data android:mimeType="model/ply" />
                <data android:mimeType="application/vnd.autodesk.fbx" />
                <data android:mimeType="model/vnd.collada+xml" />
                <data android:mimeType="model/step" />
                <data android:mimeType="application/step" />
                <data android:mimeType="application/x-step" />
                <data android:mimeType="model/iges" />
                <data android:mimeType="application/iges" />
                <data android:mimeType="application/x-iges" />
                <data android:mimeType="application/x-brep" />
                <data android:mimeType="application/x-blender" />
            </intent-filter>

            <!-- URI suffix fallbacks for providers that omit model MIME types. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" android:host="*" />
                <data android:pathPattern=".*\\.glb" />
                <data android:pathPattern=".*\\.gltf" />
                <data android:pathPattern=".*\\.stl" />
                <data android:pathPattern=".*\\.3mf" />
                <data android:pathPattern=".*\\.obj" />
                <data android:pathPattern=".*\\.ply" />
                <data android:pathPattern=".*\\.fbx" />
                <data android:pathPattern=".*\\.dae" />
                <data android:pathPattern=".*\\.step" />
                <data android:pathPattern=".*\\.stp" />
                <data android:pathPattern=".*\\.iges" />
                <data android:pathPattern=".*\\.igs" />
                <data android:pathPattern=".*\\.brep" />
                <data android:pathPattern=".*\\.blend" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" />
                <data android:pathPattern=".*\\.glb" />
                <data android:pathPattern=".*\\.gltf" />
                <data android:pathPattern=".*\\.stl" />
                <data android:pathPattern=".*\\.3mf" />
                <data android:pathPattern=".*\\.obj" />
                <data android:pathPattern=".*\\.ply" />
                <data android:pathPattern=".*\\.fbx" />
                <data android:pathPattern=".*\\.dae" />
                <data android:pathPattern=".*\\.step" />
                <data android:pathPattern=".*\\.stp" />
                <data android:pathPattern=".*\\.iges" />
                <data android:pathPattern=".*\\.igs" />
                <data android:pathPattern=".*\\.brep" />
                <data android:pathPattern=".*\\.blend" />
            </intent-filter>

            <!-- Some document providers expose model files as generic binary data. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="binary/octet-stream" />
            </intent-filter>

            <!-- Solid Explorer and older providers may label supported models as text. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" android:host="*" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/xml" />
                <data android:pathPattern=".*\.glb" />
                <data android:pathPattern=".*\.gltf" />
                <data android:pathPattern=".*\.stl" />
                <data android:pathPattern=".*\.3mf" />
                <data android:pathPattern=".*\.obj" />
                <data android:pathPattern=".*\.ply" />
                <data android:pathPattern=".*\.fbx" />
                <data android:pathPattern=".*\.dae" />
                <data android:pathPattern=".*\.step" />
                <data android:pathPattern=".*\.stp" />
                <data android:pathPattern=".*\.iges" />
                <data android:pathPattern=".*\.igs" />
                <data android:pathPattern=".*\.brep" />
                <data android:pathPattern=".*\.blend" />
            </intent-filter>

            <!-- File managers commonly use Share rather than Open for generic model files. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <!-- tauri-file-associations. AUTO-GENERATED. DO NOT REMOVE. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:pathPattern=".*\\.glb" />
                <data android:pathPattern=".*\\.gltf" />
                <data android:pathPattern=".*\\.stl" />
                <data android:pathPattern=".*\\.3mf" />
                <data android:pathPattern=".*\\.obj" />
                <data android:pathPattern=".*\\.ply" />
                <data android:pathPattern=".*\\.fbx" />
                <data android:pathPattern=".*\\.dae" />
                <data android:pathPattern=".*\\.step" />
                <data android:pathPattern=".*\\.stp" />
                <data android:pathPattern=".*\\.iges" />
                <data android:pathPattern=".*\\.igs" />
                <data android:pathPattern=".*\\.brep" />
                <data android:pathPattern=".*\\.blend" />
            </intent-filter>

            <!-- tauri-file-associations. AUTO-GENERATED. DO NOT REMOVE. -->
        </activity>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
